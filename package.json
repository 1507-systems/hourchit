{
  "name": "hourchit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable time-tracking, mileage, and invoicing for a one-person LLC. Cloudflare Worker + D1.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "profiles": "node scripts/generate-profiles.mjs",
    "predev": "npm run codegen",
    "dev": "wrangler dev",
    "pretest": "npm run codegen",
    "test": "vitest run",
    "pretest:watch": "npm run codegen",
    "test:watch": "vitest",
    "pretypecheck": "npm run codegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "predeploy": "npm run codegen",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:sql": "node seed/generate.mjs",
    "codegen": "node scripts/generate-profiles.mjs && node scripts/generate-build-info.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
